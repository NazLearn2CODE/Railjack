# Railjack hub — environment template.
#
# Copy this to ~/.config/railjack/env (the systemd unit's EnvironmentFile) and
# fill in the values. Keep secrets OUT of the repo — this file is the only key
# material that is tracked, and it ships blank on purpose. Lines without `=`
# are comments; an unset var either falls back to a default or disables the one
# feature that needs it (the hub still boots and serves 200).

# ── machine config selection ───────────────────────────────────────────────
# Optional. Force a specific configs/<name>.yaml by its filename stem. Unset →
# the lowercased `hostname -s` is matched against each config's `hostnames:` list.
# RAILJACK_CONFIG=tawhan

# ── LLM gateway — powers NEWSROOM REWRITE, THAILAND NOW publicize, ComfyUI
#    expand, NotebookLM polish (everything that calls app/zai.py) ────────────
# OmniRoute loopback gateway key (127.0.0.1:20128, combo `naz-backup`). zai.py
# reads it from here OR, if unset, from ~/.config/omniroute/.env — one of the
# two must be present for any LLM feature. z.ai is NEVER a hard dependency for
# actual calls; the gateway cascades free models so work continues past a quota.
OMNIROUTE_API_KEY=

# ── z.ai quota telemetry (session_stats; the /api/session usage HUD) ────────
# Optional. The rate-ck quota endpoint needs it; without it the usage estimate
# degrades to a heuristic. Read-only — does not consume the z.ai call quota.
ZAI_API_KEY=

# ── THAILAND NOW — EVENTS radar (free-first search) ─────────────────────────
# BRAVE is the primary scout source; GNEWS is an optional secondary. The radar
# still runs without GNEWS_KEY (fewer sources).
BRAVE_API_KEY=
GNEWS_KEY=

# ── THAILAND NOW — WRITERS (Trello bulk doc/card creation) ──────────────────
TRELLO_KEY=
TRELLO_TOKEN=

# ── THAILAND NOW — Google OAuth (run `python3 app/tn_auth.py` once to mint) ─
# Optional overrides; the defaults below are used if these are unset.
# TN_TOKEN_PATH=~/.config/railjack/google_token.json
# TN_OAUTH_CLIENT_ID=
# TN_OAUTH_CLIENT_SECRET=

# ── ComfyUI model sources (consumed by ComfyUI, not app/*.py) ───────────────
# Optional; only needed to pull gated/paid models from these registries.
# CIVITAI_API_TOKEN=
# HF_TOKEN=
