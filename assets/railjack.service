# Railjack — systemd USER unit (runs the hub as your user, not root).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp assets/railjack.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now railjack
#
# Tail logs:  journalctl --user -u railjack -f
# Stop:       systemctl --user stop railjack
#
# The repo path contains a space ("Coding Projects"). Two different rules apply:
# - WorkingDirectory is a SINGLE-VALUE directive read literally → must stay
#   UNQUOTED (quotes would become part of the path).
# - ExecStart is WORD-SPLIT on whitespace → the executable path must be QUOTED
#   or systemd runs "%h/Coding". Specifiers (%h) still expand inside quotes.
[Unit]
Description=Railjack local-services hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Coding Projects/Railjack
ExecStart="%h/Coding Projects/Railjack/.venv/bin/uvicorn" app.main:app --port 8700
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
